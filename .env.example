# Export settings explicitly; the bus does not automatically load this file.
# Only BUS_TOKEN is required for coding-only startup. Generate a random token.
BUS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_NEEDS_YOU=
# BUS_DATA_DIR=                  # host default: ~/.aos/data; bundled image sets /data
# TELEGRAM_API_BASE=https://api.telegram.org
# HEALTH_INTERVAL_SECONDS=60
# TASK_LEASE_SECONDS=600          # claim lease length; a heartbeat renews it
# TASK_SWEEP_INTERVAL_SECONDS=60  # how often expired leases are blocked
# TASK_MAX_LIVE_RUNS_PER_REPO=3   # live runs (claimed or running) a repo may have at once
# FAIL_THRESHOLD=3
# AOS_RESOURCE_ROOT=              # host resource registry; default sibling `resources` of AOS_WORKTREE_ROOT
# AOS_REQUEST_ACK_SECONDS=900      # seconds before an unacknowledged request is reported on Telegram
# --- code lane (PRs) ---
# GITHUB_TOKEN=                   # fine-grained PAT: Contents, Pull requests rw, Metadata read
# GITHUB_API_BASE=https://api.github.com
# GITHUB_MERGE_METHOD=merge       # merge | squash | rebase
# TELEGRAM_CHAT_CODE=             # the code channel; empty = TELEGRAM_CHAT_NEEDS_YOU
# CODE_POLL_INTERVAL_SECONDS=60
# CODE_INTEGRATION_CHECK=require  # require | off -- require a passing `aos integrate` check to merge
