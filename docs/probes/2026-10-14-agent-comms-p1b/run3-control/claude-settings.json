{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Agent(*)",
      "mcp__aos__*"
    ],
    "deny": [
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "disableAllHooks": true,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aos-agent inbox --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/aos-agent stop --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}